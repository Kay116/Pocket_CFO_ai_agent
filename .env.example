# Copy to .env (git-ignored) or export in your shell. Never commit real values.
CLOUDANT_URL=https://<account>.cloudantnosqldb.appdomain.cloud
CLOUDANT_APIKEY=<setup key - Manager role, used only by db/setup_cloudant.py>
CLOUDANT_RUNTIME_APIKEY=<service ID key - Writer role, stored in the watsonx connection>
USER_KEY_PEPPER=<openssl rand -hex 32 - generate once, never change>
